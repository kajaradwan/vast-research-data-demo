# vast-research-data-demo: every cluster- and host-specific value lives here. Copy to .env and edit.
# Nothing cluster-specific is in code. preflight.sh checks every value before deploy touches anything.

# --- cluster (management plane, reached from the Mac and from the client) ---
RLU_VMS=192.0.2.10
# key into ~/.vast/vms-creds.json on the Mac for the build login (cluster admin, Mac only, never on the client)
RLU_CLUSTER=lab

# --- what we create (all names derive from these) ---
RLU_TENANT=rad-lab-users
RLU_PREFIX=rlu
# protocol VIPs (S3, NFS, VAST DB) and the event-broker VIPs; preflight refuses a range another pool already holds
RLU_POOL_RANGE=198.18.0.174-198.18.0.176
RLU_KAFKA_RANGE=198.18.0.177-198.18.0.178
RLU_SUBNET_CIDR=16
# uids for the tenant's local users: svc, ingest, analyst = base+1..3; the four "PI home" owners = base+11..14
RLU_UID_BASE=7200

# --- the compute/data client (inside the data network; runs the function stand-in, Trino and the live deck) ---
RLU_CLIENT=vastdata@192.0.2.111
# addresses the client uses on the data network: the only hosts the NFS export allows
RLU_CLIENT_NFS_IPS=198.18.5.111,198.18.6.111
RLU_CLIENT_DIR=/home/vastdata/vast-research-data-demo
RLU_SRV=/srv/rad-lab-users
RLU_MNT=/mnt/rad-lab-users

# --- client services ---
# Trino image must match the cluster release: trino-vast:478 for 5.5, trino-vast:475 for 5.4
RLU_TRINO_IMAGE=vastdataorg/trino-vast:478
RLU_TRINO_PORT=8086
RLU_LIVE_PORT=8097
# parallel workers for the transform and the file arm of the SFS query
RLU_WORKERS=96
